# PostgreSQL connection string used by @payloadcms/db-postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full

# Used by Payload to encrypt JWT tokens and other sensitive values
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Public app URL used for previews, CORS, metadata, and generated links. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate Payload scheduled jobs / Vercel cron calls
CRON_SECRET=replace-with-a-long-random-secret

# Secret used to validate draft preview requests
PREVIEW_SECRET=replace-with-a-long-random-secret

# Resend powers Payload auth and writer invite emails
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_ADDRESS=onboarding@resend.dev

# Persistent media storage. Use "local" without S3 values for local development only.
MEDIA_STORAGE_PROVIDER=s3
NEXT_PUBLIC_MEDIA_DELIVERY=payload
S3_BUCKET=editorial-panfleto
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=replace-with-r2-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
